{
  "manifest_version": 3,
  "name": "Ortus \u00b7 Website blocking",
  "version": "0.2.0",
  "description": "Keep the websites you choose out of your focus time. Controlled locally by Ortus.",
  "key": "",
  "permissions": [
    "declarativeNetRequest",
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ortus"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "style.css",
        "core.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "minimum_chrome_version": "120"
}
